; Engine configuration file.
; It's best edited using the editor UI and not directly.

config_version=5

[application]

config/name="Planet Render 360"
config/description="Render any point on the map as a 3D, 360-degree view."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.png"
; Brand boot splash (design system: stacked lockup on the Night ground,
; sky-000 #06090f). The square PNG is scaled to fit and letterboxed with
; the same colour, so it reads as one flat ground at any window shape.
boot_splash/bg_color=Color(0.0235, 0.0353, 0.0588, 1)
boot_splash/image="res://assets/brand/pr360-splash.png"
boot_splash/fullsize=true
boot_splash/use_filter=true

[display]

; Mobile-first logical size (points, not device pixels). 390x844 is the
; phone design frame; canvas_items scaling maps it to any device DPI, so
; 16pt type stays 16pt on a phone, a tablet, and a Retina Mac alike.
; The old 1170x2532 frame was device pixels at 3x, which shrank every
; fixed-size control to a third of its intended size on desktop.
window/size/viewport_width=390
window/size/viewport_height=844
window/size/resizable=true
; Always start full screen (DisplayServer.WINDOW_MODE_FULLSCREEN).
; This is the single place that owns the startup window mode: it is
; applied when the window is created, in the editor run and in
; exports alike. Full screen makes the window match the actual
; screen, and canvas_items/expand stretch below plus the Responsive
; breakpoints relayout every screen to fit it. Mobile is inherently
; full screen, so this mainly fixes macOS/desktop.
window/size/mode=3
; Windowed size restored if the user leaves full screen (ignored on
; phones). Wide enough for the expanded responsive layout.
window/size/window_width_override=1180
window/size/window_height_override=820
window/handheld/orientation="portrait"
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
reflections/reflection_atlas/reflection_size=512
reflections/reflection_atlas/reflection_size.mobile=256
reflections/reflection_atlas/reflection_count=4
environment/defaults/default_clear_color=Color(0.925, 0.937, 0.929, 1)
textures/vram_compression/import_etc2_astc=true

[shader_globals]

climate_snow_on={
"type": "float",
"value": 0.0
}
climate_snow_y={
"type": "float",
"value": 100000.0
}
climate_snow_band={
"type": "float",
"value": 150.0
}
climate_wetness={
"type": "float",
"value": 0.0
}
climate_water_ice={
"type": "float",
"value": 0.0
}
cloud_shadow_cover={
"type": "float",
"value": 0.0
}
cloud_shadow_drift={
"type": "float",
"value": 0.0
}
cloud_shadow_stretch={
"type": "float",
"value": 1.0
}
cloud_sun_dir={
"type": "vec3",
"value": Vector3(0, 1, 0)
}
