class_name LandmarkSetVenice
extends RefCounted

## Builders of the Venice super-realistic landmark batch (`LandmarkRegistryVenice`).
## Returns false for unknown types so `LandmarkBuilder` continues down the sets list.

static func build(model: Node3D, type: String) -> bool:
	match type:
		"san_giorgio_maggiore":
			VnSanGiorgio.build(model)
		"punta_della_dogana":
			VnPuntaDogana.build(model)
		"ponte_accademia":
			VnBridges.ponte_accademia(model)
		"ponte_scalzi":
			VnBridges.ponte_scalzi(model)
		"ponte_costituzione":
			VnBridges.ponte_costituzione(model)
		"ponte_paglia":
			VnBridges.ponte_paglia(model)
		"ponte_guglie":
			VnBridges.ponte_guglie(model)
		"ponte_tre_archi":
			VnBridges.ponte_tre_archi(model)
		"palazzo_cavalli_franchetti":
			VnAccademiaCorridor.cavalli_franchetti(model)
		"palazzo_barbaro":
			VnAccademiaCorridor.palazzo_barbaro(model)
		"palazzo_contarini_polignac":
			VnAccademiaCorridor.contarini_polignac(model)
		"gallerie_accademia":
			VnAccademiaCorridor.gallerie_accademia(model)
		"san_vidal_chiesa":
			VnAccademiaCorridor.san_vidal(model)
		"palazzo_barbarigo":
			VnDorsoduroCanal.palazzo_barbarigo(model)
		"palazzo_venier_guggenheim":
			VnDorsoduroCanal.venier_guggenheim(model)
		"ca_dario":
			VnDorsoduroCanal.ca_dario(model)
		"san_gregorio_abbazia":
			VnDorsoduroCanal.san_gregorio(model)
		"palazzo_corner_ca_granda":
			VnSanMarcoCanal.corner_ca_granda(model)
		"gritti_palace":
			VnSanMarcoCanal.gritti_palace(model)
		"palazzo_ferro_fini_bauer":
			VnSanMarcoCanal.ferro_fini_bauer(model)
		"procuratie_piazza_san_marco":
			VnProcuratie.build(model)
		"biblioteca_marciana":
			VnMarcianaMolo.biblioteca_marciana(model)
		"torre_orologio":
			VnMarcianaMolo.torre_orologio(model)
		"colonne_san_marco":
			VnMarcianaMolo.colonne_san_marco(model)
		"prigioni_danieli":
			VnMarcianaMolo.prigioni_danieli(model)
		"teatro_la_fenice":
			VnSanMarcoInterior.teatro_la_fenice(model)
		"contarini_del_bovolo":
			VnSanMarcoInterior.contarini_del_bovolo(model)
		"ca_rezzonico":
			VnVoltaCanal.ca_rezzonico(model)
		"palazzo_grassi":
			VnVoltaCanal.palazzo_grassi(model)
		"ca_foscari":
			VnVoltaCanal.ca_foscari(model)
		"fondaco_dei_tedeschi":
			VnRialtoEnsemble.fondaco_dei_tedeschi(model)
		"palazzo_camerlenghi":
			VnRialtoEnsemble.palazzo_camerlenghi(model)
		"rialto_mercato_pescheria":
			VnRialtoEnsemble.rialto_mercato_pescheria(model)
		"ca_doro":
			VnUpperGrandCanal.ca_doro(model)
		"ca_pesaro":
			VnUpperGrandCanal.ca_pesaro(model)
		"fontego_dei_turchi":
			VnUpperGrandCanal.fontego_dei_turchi(model)
		"ca_vendramin_calergi":
			VnUpperGrandCanal.vendramin_calergi(model)
		"san_simeone_piccolo":
			VnUpperGrandCanal.san_simeone_piccolo(model)
		"stazione_santa_lucia":
			VnUpperGrandCanal.stazione_santa_lucia(model)
		"il_redentore":
			VnGiudecca.il_redentore(model)
		"le_zitelle":
			VnGiudecca.le_zitelle(model)
		"molino_stucky":
			VnGiudecca.molino_stucky(model)
		"basilica_dei_frari":
			VnSanPoloDorsoduro.basilica_dei_frari(model)
		"scuola_grande_san_rocco":
			VnSanPoloDorsoduro.scuola_grande_san_rocco(model)
		"chiesa_santo_stefano":
			VnSanPoloDorsoduro.santo_stefano(model)
		"chiesa_gesuati":
			VnSanPoloDorsoduro.chiesa_gesuati(model)
		"squero_san_trovaso":
			VnSanPoloDorsoduro.squero_san_trovaso(model)
		"santa_maria_miracoli":
			VnCastelloCannaregio.santa_maria_miracoli(model)
		"san_zaccaria":
			VnCastelloCannaregio.san_zaccaria(model)
		"chiesa_san_moise":
			VnCastelloCannaregio.chiesa_san_moise(model)
		"santa_maria_formosa":
			VnCastelloCannaregio.santa_maria_formosa(model)
		"zanipolo_san_marco":
			VnOuterCastelloLagoon.zanipolo_san_marco(model)
		"arsenale_venezia":
			VnOuterCastelloLagoon.arsenale_venezia(model)
		"san_pietro_castello":
			VnOuterCastelloLagoon.san_pietro_castello(model)
		"chiesa_gesuiti_orto":
			VnOuterCastelloLagoon.chiesa_gesuiti_orto(model)
		"san_michele_island":
			VnOuterCastelloLagoon.san_michele_island(model)
		"murano_faro_donato":
			VnOuterCastelloLagoon.murano_faro(model)
		_:
			return false
	return true
