class_name LandmarkSetFinlandHelsinki
extends RefCounted

## Builders of the finland_helsinki landmark batch: one `match` arm per
## registry type of LandmarkRegistryFinlandHelsinki. Returns false for a type it does
## not own so LandmarkBuilder tries the next set.

static func build(model: Node3D, type: String) -> bool:
	match type:
		"otaniemi_chapel": LandmarkFhEspoo.otaniemi_chapel(model)
		"aalto_university_main": LandmarkFhEspoo.aalto_main(model)
		"tapiola_church": LandmarkFhEspoo.tapiola_church(model)
		"tapiola_central_tower": LandmarkFhEspoo.keskustorni(model)
		"weegee": LandmarkFhEspoo.weegee(model)
		"finago_tower": LandmarkFhKeilaniemi.finago(model)
		"kone_building": LandmarkFhKeilaniemi.kone(model)
		"keilalampi": LandmarkFhKeilaniemi.keilalampi(model)
		"espoo_cultural_centre": LandmarkFhTapiola.cultural_centre(model)
		"mantytorni": LandmarkFhTapiola.mantytorni(model)
		"tapiola_hip_flask_houses": LandmarkFhTapiola.hip_flask_houses(model)
		"lauttasaari_church": LandmarkFhLauttasaari.church(model)
		"lauttasaari_manor": LandmarkFhLauttasaari.manor(model)
		"kamppi_chapel": LandmarkFhHeroCivic.kamppi(model)
		"amos_rex": LandmarkFhHeroCivic.amos(model)
		"havis_amanda": LandmarkFhHeroHarbour.havis(model)
		"kappeli": LandmarkFhHeroHarbour.kappeli(model)
		"skywheel_helsinki": LandmarkFhHeroHarbour.skywheel(model)
		"allas_sea_pool": LandmarkFhHeroHarbour.allas(model)
		"stockmann_helsinki": LandmarkFhHeroCivic.stockmann(model)
		"hakaniemi_market_hall": LandmarkFhHeroCivic.hakaniemi(model)
		"government_palace_helsinki": LandmarkFhHeroCivic.empire(model, true)
		"helsinki_university_main": LandmarkFhHeroCivic.empire(model, false)
		"uspenski_cathedral": LandmarkFhHelsinkiSacred.uspenski(model)
		"temppeliaukio_church": LandmarkFhHelsinkiSacred.temppeliaukio(model)
		"st_johns_church_helsinki": LandmarkFhHelsinkiChurches.stjohns(model)
		"kallio_church": LandmarkFhHelsinkiChurches.kallio(model)
		"national_museum_of_finland": LandmarkFhHelsinkiCivic.natmuseum(model)
		"parliament_house_helsinki": LandmarkFhHelsinkiCivic.parliament(model)
		"presidential_palace_helsinki": LandmarkFhHelsinkiCivic.presidential(model)
		"ateneum": LandmarkFhHelsinkiCivic.ateneum(model)
		"finlandia_hall": LandmarkFhHelsinkiHalls.finlandia(model)
		"finnish_national_opera": LandmarkFhHelsinkiHalls.opera(model)
		"helsinki_music_centre": LandmarkFhHelsinkiHalls.music(model)
		"kiasma": LandmarkFhHelsinkiModern.kiasma(model)
		"oodi_library": LandmarkFhHelsinkiModern.oodi(model)
		"dipoli": LandmarkFhHelsinkiModern.dipoli(model)
		"heureka_science_centre": LandmarkFhHelsinkiModern.heureka(model)
		"helsinki_central_station": LandmarkFhHelsinkiCity.station(model)
		"hotel_torni": LandmarkFhHelsinkiCity.torni(model)
		"old_market_hall_helsinki": LandmarkFhHelsinkiCity.markethall(model)
		"national_library_of_finland": LandmarkFhHelsinkiCity.natlibrary(model)
		"sibelius_monument": LandmarkFhHelsinkiMonuments.sibelius(model)
		"suomenlinna_fortress": LandmarkFhHelsinkiMonuments.suomenlinna(model)
		"helsinki_olympic_stadium": LandmarkFhHelsinkiMonuments.stadium(model)
		"majakka": LandmarkFhKalasatama.majakka(model)
		"loisto": LandmarkFhKalasatama.loisto(model)
		"lumo_one": LandmarkFhKalasatama.lumo_one(model)
		"horisontti": LandmarkFhKalasatama.horisontti(model)
		"visio": LandmarkFhKalasatama.visio(model)
		"redi_shopping_centre": LandmarkFhMalls.redi(model)
		"mall_of_tripla": LandmarkFhMalls.tripla(model)
		"itis_shopping_centre": LandmarkFhMalls.itis(model)
		"iso_omena": LandmarkFhMalls.iso_omena(model)
		"sello_shopping_centre": LandmarkFhMalls.sello(model)
		"jumbo_shopping_centre": LandmarkFhMalls.jumbo(model)
		"suomenlinna_kings_gate": LandmarkFhSuomenlinnaParts.kings_gate(model)
		"suomenlinna_dry_dock": LandmarkFhSuomenlinnaParts.dry_dock(model)
		"suomenlinna_jetty_barracks": LandmarkFhSuomenlinnaParts.jetty_barracks(model)
		"hanko_water_tower": LandmarkFhHelsinkiMonuments.hanko(model)
		"espoo_cathedral": LandmarkFhRegionalChurches.espoo(model)
		"porvoo_cathedral": LandmarkFhRegionalChurches.porvoo(model)
		_:
			return false
	return true
