static func solids() -> Array[Rect2]:
	var out: Array[Rect2] = [HALL, CENTRAL, VICTORIA, ELIZABETH]
	for i in range(0, RANGES.size(), 5):
		out.append(Rect2(RANGES[i], RANGES[i + 1], RANGES[i + 2] - RANGES[i], RANGES[i + 3] - RANGES[i + 1]))
	return out
