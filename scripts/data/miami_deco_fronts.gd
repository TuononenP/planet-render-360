## Curated Deco street-front row for OSM building `b`, or `{}` when unmapped.
static func row_for(b: Dictionary) -> Dictionary:
	for raw_id in OsmParser.ids_of(b):
		var id := str(raw_id)
		if ROWS.has(id):
			return ROWS[id] as Dictionary
	return {}
