class_name TerrainBuilder
extends RefCounted

## Builds renderable 3D from a LocationData height grid.
## World scale: 1 unit = 4 m. Visual target: visual-plan/PRD.md
## Fidelity 3 photoreal PBR scenery, golden-hour grade, aerial haze.

const WORLD_SIZE := 220.0
const METRES_TO_WORLD := 0.25
## Fallback cap when data carries no preset; RenderSettings owns the
## per-preset building/tree budgets actually used below.
const MAX_REAL_BUILDINGS := 340
const LANDMARK_POS := Vector2(18, -14)

static var _facade_mats: Array = []
static var _leaf_mats_by_season: Dictionary = {}
static var _unit_box: BoxMesh

static func _range_of(values: PackedFloat32Array) -> Vector2:
	var mn := INF
	var mx := -INF
	for v in values:
		mn = minf(mn, v)
		mx = maxf(mx, v)
	return Vector2(mn, mx)

static func _polys(data: LocationData, classes: Array) -> Array:
	var out: Array = []
	for poly in data.land_polygons:
		if str(poly.get("class", "")) in classes:
			out.append(poly["points"])
	return out

static func _colored_mesh(verts: PackedVector3Array, normals: PackedVector3Array,
		colors: PackedColorArray, indices: PackedInt32Array,
		roughness: float = 1.0, cull_disabled: bool = false,
		uvs: PackedVector2Array = PackedVector2Array(),
		tex: Texture2D = null) -> MeshInstance3D:
	if normals.is_empty():
		for i in verts.size():
			normals.append(Vector3.UP)
	var arrays: Array = []
	arrays.resize(Mesh.ARRAY_MAX)
	arrays[Mesh.ARRAY_VERTEX] = verts
	arrays[Mesh.ARRAY_NORMAL] = normals
	arrays[Mesh.ARRAY_COLOR] = colors
	arrays[Mesh.ARRAY_INDEX] = indices
	if not uvs.is_empty():
		arrays[Mesh.ARRAY_TEX_UV] = uvs
	var mesh := ArrayMesh.new()
	mesh.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, arrays)
	var mat := StandardMaterial3D.new()
	mat.vertex_color_use_as_albedo = true
	if tex != null:
		# Imagery carries the albedo; vertex colour becomes a slope
		# shade multiplied over it (see _terrain_mesh).
		mat.albedo_texture = tex
	mat.roughness = roughness
	if cull_disabled:
		mat.cull_mode = BaseMaterial3D.CULL_DISABLED
	return _add(null, mesh, mat)

static func _cyl(top_r: float, bottom_r: float, height: float, segments: int = 8) -> CylinderMesh:
	var c := CylinderMesh.new()
	c.top_radius = top_r
	c.bottom_radius = bottom_r
	c.height = height
	c.radial_segments = segments
	return c

static func _add(parent: Node, mesh: Mesh, mat: Material) -> MeshInstance3D:
	var mi := MeshInstance3D.new()
	mi.mesh = mesh
	mi.material_override = mat
	if parent != null:
		parent.add_child(mi)
	return mi

static func _box_mesh() -> BoxMesh:
	if _unit_box == null:
		_unit_box = BoxMesh.new()
		_unit_box.size = Vector3.ONE
	return _unit_box

static func build_world(data: LocationData) -> Node3D:
	var root := Node3D.new()
	root.name = "GeneratedWorld"
	root.add_child(_far_ground(data))
	root.add_child(_far_terrain(data))
	root.add_child(_terrain_mesh(data))
	root.add_child(_water(data))
	_river_dressing(root, data)
	if data.buildings.is_empty():
		_buildings(root, data)
		_city_silhouette(root, data)
	else:
		_real_buildings(root, data)
		_roads(root, data)
		# OSM alone leaves gaps the ref never has: procedural
		# Haussmann infill fills them (it skips real footprints,
		# water and the landmark clearing).
		_buildings(root, data)
		_city_silhouette(root, data)
	if data.landmark_type != "none":
		root.add_child(_landmark(data))
	_landmark_candidates(root, data)
	_vegetation(root, data)
	return root

## Notable OSM features near the viewpoint as archetypes (nearest
## five; the curated registry landmark above stays the hero).
static func _landmark_candidates(root: Node3D, data: LocationData) -> void:
	var placed := 0
	for c in data.landmark_candidates:
		if placed >= 5:
			break
		var cx := float(c.get("x", 0.0))
		var cz := float(c.get("z", 0.0))
		if absf(cx) > 105.0 or absf(cz) > 105.0:
			continue
		var node := LandmarkBuilder.build_archetype(
			str(c.get("archetype", "tower")), float(c.get("height", 30.0)),
			Vector2(float(c.get("size_x", 12.0)), float(c.get("size_z", 12.0))))
		node.position = Vector3(cx, _ground_at(data, cx, cz) - 0.3, cz)
		root.add_child(node)
		placed += 1

static func _near_landmark_candidate(data: LocationData, x: float, z: float) -> bool:
	for c in data.landmark_candidates:
		if Vector2(x - float(c.get("x", 0.0)), z - float(c.get("z", 0.0))).length() < 9.0:
			return true
	return false

static func _mat(color: Color, roughness: float = 0.95) -> StandardMaterial3D:
	var m := StandardMaterial3D.new()
	m.albedo_color = color
	m.roughness = roughness
	return m

static func _hash(x: float, z: float) -> float:
	return fmod(absf(sin(x * 12.9898 + z * 78.233) * 43758.5453), 1.0)

# --- Shared facade materials: window-grid texture tinted per material,
# so hundreds of buildings cost a handful of materials, not hundreds.

static var _slate_mat: StandardMaterial3D
static var _detail_tex: Texture2D
static var _leaf_tex: Texture2D

## Photographic-style grain: thousands of tiny speckles over a base so
## no surface reads as a flat colour slab at Fidelity 2-3 (PRD §3.1).
static func _speckle(img: Image, base: Color, n: int, seed_v: float, amp: float) -> void:
	img.fill(base)
	for i in n:
		var x := int(_hash(i * 1.37, seed_v) * float(img.get_width() - 2))
		var y := int(_hash(seed_v, i * 2.11) * float(img.get_height() - 2))
		var v := (_hash(i * 3.7, seed_v * 1.3) - 0.5) * 2.0 * amp
		img.fill_rect(Rect2i(x, y, 2, 2), Color(
			clampf(base.r + v, 0.0, 1.0), clampf(base.g + v * 0.95, 0.0, 1.0),
			clampf(base.b + v * 0.85, 0.0, 1.0)))

static func _detail_texture() -> Texture2D:
	if _detail_tex != null:
		return _detail_tex
	var img := Image.create(128, 128, true, Image.FORMAT_RGBA8)
	_speckle(img, Color(0.94, 0.94, 0.94), 2600, 4.2, 0.10)
	_detail_tex = ImageTexture.create_from_image(img)
	return _detail_tex

static func _slate() -> StandardMaterial3D:
	if _slate_mat != null:
		return _slate_mat
	var img := Image.create(128, 128, true, Image.FORMAT_RGBA8)
	_speckle(img, Color(0.275, 0.32, 0.37), 900, 8.1, 0.05)  # slate #46525E
	for row in 8:  # slate tile courses
		var y := row * 16
		img.fill_rect(Rect2i(0, y, 128, 1), Color(0.16, 0.19, 0.23))
		for col in 4:
			img.fill_rect(Rect2i(col * 32 + (16 if row % 2 else 0), y, 1, 16),
				Color(0.18, 0.21, 0.26))
	_slate_mat = StandardMaterial3D.new()
	_slate_mat.albedo_texture = ImageTexture.create_from_image(img)
	_slate_mat.roughness = 0.62
	_slate_mat.metallic = 0.08
	_slate_mat.uv1_scale = Vector3(3.0, 3.0, 3.0)
	return _slate_mat

static func _leaf_texture() -> Texture2D:
	if _leaf_tex != null:
		return _leaf_tex
	var img := Image.create(128, 128, true, Image.FORMAT_RGBA8)
	_speckle(img, Color(0.84, 0.87, 0.82), 3200, 6.4, 0.08)
	_leaf_tex = ImageTexture.create_from_image(img)
	return _leaf_tex

static func _facades() -> Array:
	if not _facade_mats.is_empty():
		return _facade_mats
	# Haussmann limestone (PRD §3.2 #D6C5A3, §4.2): 6 storeys x 6 bays,
	# French windows with frames, shutters, balcony rails, cornices,
	# stone coursing and a grime gradient at the base.
	var img := Image.create(512, 512, true, Image.FORMAT_RGBA8)
	var nimg := Image.create(512, 512, false, Image.FORMAT_RGB8)
	nimg.fill(Color(0.5, 0.5, 1.0))  # flat wall in tangent-space normal
	_speckle(img, Color(0.74, 0.65, 0.51), 16000, 2.3, 0.05)
	for floor_i in 6:
		var fy := 20 + floor_i * 80
		img.fill_rect(Rect2i(0, fy - 10, 512, 4), Color(0.90, 0.84, 0.70))  # cornice light
		img.fill_rect(Rect2i(0, fy - 6, 512, 2), Color(0.62, 0.55, 0.43))  # cornice shadow
		nimg.fill_rect(Rect2i(0, fy - 10, 512, 4), Color(0.62, 0.5, 1.0))
		for col in 6:
			var wx := 28 + col * 80
			var hv := _hash(col * 9.3, floor_i * 3.9)
			if hv < 0.30:  # shutters on <=30% (PRD §4.2)
				img.fill_rect(Rect2i(wx - 14, fy, 12, 60), Color(0.45, 0.52, 0.50))
				img.fill_rect(Rect2i(wx + 38, fy, 12, 60), Color(0.45, 0.52, 0.50))
			img.fill_rect(Rect2i(wx - 4, fy - 4, 44, 68), Color(0.93, 0.90, 0.82))
			var glass := Color(0.05, 0.08, 0.11)  # dark glass #2E3A40, deep read
			if hv > 0.93:
				glass = Color(0.85, 0.62, 0.34)  # a few warm lit windows
			img.fill_rect(Rect2i(wx + 3, fy + 4, 30, 52), glass)
			img.fill_rect(Rect2i(wx + 3, fy + 4, 30, 8), Color(0.16, 0.22, 0.27))  # sky reflection
			img.fill_rect(Rect2i(wx + 17, fy + 4, 3, 52), Color(0.88, 0.85, 0.76))  # mullion
			img.fill_rect(Rect2i(wx + 3, fy + 30, 30, 3), Color(0.88, 0.85, 0.76))
			# Recessed-window bevel in the normal map.
			nimg.fill_rect(Rect2i(wx - 4, fy - 4, 44, 4), Color(0.38, 0.38, 1.0))
			nimg.fill_rect(Rect2i(wx - 4, fy, 4, 68), Color(0.38, 0.5, 1.0))
			nimg.fill_rect(Rect2i(wx + 36, fy, 4, 68), Color(0.62, 0.5, 1.0))
			nimg.fill_rect(Rect2i(wx - 4, fy + 64, 44, 4), Color(0.62, 0.62, 1.0))
		if floor_i == 1 or floor_i == 4:  # balcony rails, floors 2 and 5
			img.fill_rect(Rect2i(0, fy + 62, 512, 4), Color(0.16, 0.16, 0.17))
			for bx in range(8, 512, 16):
				img.fill_rect(Rect2i(bx, fy + 50, 2, 14), Color(0.18, 0.18, 0.19))
	for gy in 52:  # grime: bottom 1.5 m darkened ~15% (PRD §4.2)
		var t := float(gy) / 52.0
		img.fill_rect(Rect2i(0, 460 + gy, 512, 1),
			Color(0.84, 0.77, 0.64).lerp(Color(0.55, 0.49, 0.40), (1.0 - t) * 0.55))
	var tex := ImageTexture.create_from_image(img)
	var ntex := ImageTexture.create_from_image(nimg)
	var rough := Image.create(64, 64, false, Image.FORMAT_R8)
	_speckle(rough, Color(0.85, 0.85, 0.85), 700, 9.7, 0.10)
	# >=6 facade variants, hue shift <=+-4%, value +-8% (PRD §4.2).
	for tint in [Color(1.0, 0.99, 0.96), Color(0.96, 0.93, 0.88), Color(1.03, 1.0, 0.93),
			Color(0.93, 0.90, 0.86), Color(1.0, 0.96, 0.90), Color(0.97, 0.95, 0.99)]:
		var m := StandardMaterial3D.new()
		m.albedo_texture = tex
		m.albedo_color = tint
		m.normal_texture = ntex
		m.normal_scale = 0.7
		m.roughness_texture = ImageTexture.create_from_image(rough)
		m.roughness = 0.88
		_facade_mats.append(m)
	return _facade_mats

static func _leaves(season: int = LocationData.Season.SUMMER) -> Array:
	var key := LocationData.clamp_season(season)
	if _leaf_mats_by_season.has(key):
		return _leaf_mats_by_season[key]
	var palettes: Array = [
		[Color(0.38, 0.55, 0.30), Color(0.45, 0.60, 0.33), Color(0.32, 0.48, 0.27)],  # spring
		[Color(0.30, 0.45, 0.26), Color(0.36, 0.50, 0.28), Color(0.24, 0.38, 0.22)],  # summer
		[Color(0.72, 0.42, 0.20), Color(0.65, 0.35, 0.16), Color(0.55, 0.45, 0.20)],  # autumn
		[Color(0.35, 0.30, 0.24), Color(0.30, 0.36, 0.24), Color(0.38, 0.33, 0.26)],  # winter
	]
	var mats: Array = []
	for c in palettes[key]:
		# +-10% hue/value variance per material (PRD §4.4); the leaf
		# speckle texture stops canopies reading as flat blobs.
		for v in [0.92, 1.0, 1.08]:
			var m := _mat(Color(c.r * v, c.g * v, c.b * (2.0 - v) * 0.96), 0.92)
			m.albedo_texture = _leaf_texture()
			mats.append(m)
	_leaf_mats_by_season[key] = mats
	return mats

## The one ground truth for the whole world: raw heights smoothed,
## flattened in low-relief cities, and carved under water polygons.
## Mesh, buildings, roads, trees, and landmarks all sample this.
static func _heights(data: LocationData) -> PackedFloat32Array:
	var size := data.grid_size
	if data.display_heights.size() == size * size:
		return data.display_heights
	var raw_range := _range_of(data.heights)
	var hs := PackedFloat32Array()
	hs.resize(size * size)
	for z in size:
		for x in size:
			var sum := data.height_at(x, z) * 2.0
			var n := 2.0
			for dz in [-1, 0, 1]:
				for dx in [-1, 0, 1]:
					if dx == 0 and dz == 0:
						continue
					sum += data.height_at(x + dx, z + dz)
					n += 1.0
			hs[z * size + x] = sum / n
	if raw_range.y - raw_range.x < 20.0:
		# Low-relief places (cities) should read flat, not as dunes.
		var centre_h := data.height_at(size / 2, size / 2)
		for i in hs.size():
			hs[i] = lerpf(hs[i], centre_h, 0.87)
	var step := WORLD_SIZE / float(size - 1)
	for pts in _polys(data, ["water"]):
		for z in size:
			for x in size:
				var wx := (x - size / 2.0) * step
				var wz := (z - size / 2.0) * step
				if point_in_polygon(Vector2(wx, wz), pts):
					# Below the water plane, or the channel terrain
					# covers the river surface entirely.
					hs[z * size + x] = minf(hs[z * size + x], data.water_level - 0.55)
	# Synthetic Seine-class river (PRD §4.3): when OSM gave no water
	# polygon, a flat city still gets its S-curve, carved below the
	# water plane so the PBR surface shows in the channel.
	var river := _river_path(data)
	if not river.is_empty():
		for z in size:
			for x in size:
				var wx := (x - size / 2.0) * step
				var wz := (z - size / 2.0) * step
				var d := _path_dist(Vector2(wx, wz), river)
				if d < RIVER_HALF + 2.5:
					var depth := lerpf(data.water_level - 0.7,
						hs[z * size + x], smoothstep(RIVER_HALF - 0.5,
							RIVER_HALF + 2.5, d))
					hs[z * size + x] = minf(hs[z * size + x], depth)
	data.display_heights = hs
	return hs

const RIVER_HALF := 10.0  # 20 units = 80 m wide (PRD §4.3: 80-120 m)

## Guaranteed river: an S-curve across the world (Paris spawn
## framing), or empty when OSM water exists or the place is hilly.
static func _river_path(data: LocationData) -> PackedVector2Array:
	if data.grid_size < 32 or not _polys(data, ["water"]).is_empty():
		return PackedVector2Array()  # fixtures / real OSM water wins
	if data.buildings.is_empty() and data.relief_metres >= 120.0:
		return PackedVector2Array()
	return PackedVector2Array([Vector2(118, -34), Vector2(62, -14),
		Vector2(14, 3), Vector2(-32, 12), Vector2(-72, -4),
		Vector2(-118, -22)])

static func _path_dist(p: Vector2, path: PackedVector2Array) -> float:
	var best := INF
	for i in path.size() - 1:
		var a := path[i]
		var ab := path[i + 1] - a
		var t := clampf((p - a).dot(ab) / maxf(ab.length_squared(), 0.001), 0.0, 1.0)
		best = minf(best, (a + ab * t - p).length())
	return best

static func _path_point(path: PackedVector2Array, frac: float) -> Vector2:
	var total := 0.0
	for i in path.size() - 1:
		total += path[i].distance_to(path[i + 1])
	var target := total * clampf(frac, 0.0, 1.0)
	for i in path.size() - 1:
		var seg := path[i].distance_to(path[i + 1])
		if target <= seg:
			return path[i].lerp(path[i + 1], target / maxf(seg, 0.001))
		target -= seg
	return path[path.size() - 1]

## Stone quays, three bridges and tree rows for the synthetic
## river (PRD §4.3/§4.4); OSM rivers are dressed by other passes.
static func _river_dressing(root: Node3D, data: LocationData) -> void:
	var river := _river_path(data)
	if river.is_empty():
		return
	var stone := _mat(Color(0.54, 0.51, 0.45), 0.95)  # quay #8A8274
	var wl := data.water_level
	for i in river.size() - 1:
		var a := river[i]
		var b := river[i + 1]
		var dir := (b - a).normalized()
		var side := Vector2(-dir.y, dir.x)
		for s in [-1.0, 1.0]:
			var mid: Vector2 = (a + b) / 2.0 + side * s * (RIVER_HALF + 0.5)
			var wall := _add(root, _box_mesh(), stone)
			wall.scale = Vector3(a.distance_to(b) + 1.0, 1.5, 0.7)
			wall.position = Vector3(mid.x, wl + 0.45, mid.y)
			wall.rotation.y = -atan2(dir.y, dir.x)
	var deck_mat := _mat(Color(0.62, 0.58, 0.50), 0.9)
	for frac in [0.26, 0.52, 0.78]:  # >=3 bridges in view (PRD §4.3)
		var c := _path_point(river, frac)
		var c2 := _path_point(river, frac + 0.02)
		var dir := (c2 - c).normalized()
		var deck := _add(root, _box_mesh(), deck_mat)
		deck.scale = Vector3(3.2, 0.5, (RIVER_HALF + 3.5) * 2.0)
		deck.position = Vector3(c.x, wl + 1.55, c.y)
		deck.rotation.y = -atan2(dir.y, dir.x) + PI / 2.0
		for s in [-0.55, 0.55]:
			var pier := _add(root, _box_mesh(), stone)
			pier.scale = Vector3(2.6, 2.2, 1.4)
			pier.position = Vector3(c.x - dir.y * s * RIVER_HALF * 2.0,
				wl + 0.4, c.y + dir.x * s * RIVER_HALF * 2.0)
	var rng := RandomNumberGenerator.new()
	rng.seed = data.seed_value + 41
	var leaves := _leaves(data.season)
	var trunk_mat := _mat(Color(0.36, 0.28, 0.20), 0.95)
	var t := 2.0
	while t < 96.0:  # quay rows both banks, 8-12 m spacing (PRD §4.4)
		var c := _path_point(river, t / 100.0)
		var c2 := _path_point(river, t / 100.0 + 0.015)
		var dir := (c2 - c).normalized()
		var side := Vector2(-dir.y, dir.x)
		for s in [-1.0, 1.0]:
			if rng.randf() < 0.14:
				continue
			var p: Vector2 = c + side * s * (RIVER_HALF + 1.8)
			var pos := Vector3(p.x, _ground_at(data, p.x, p.y), p.y)
			_broadleaf(root, pos, rng, leaves, trunk_mat, data.season)
		t += rng.randf_range(2.2, 3.0)

## World XZ -> satellite mosaic UV (north is -Z).
static func satellite_uv(data: LocationData, wx: float, wz: float) -> Vector2:
	var east_m := wx / METRES_TO_WORLD
	var north_m := -wz / METRES_TO_WORLD
	var lat := data.latitude + north_m / 110540.0
	var lon := data.longitude + east_m / (111320.0 * cos(deg_to_rad(data.latitude)))
	var px := TileFetcher.global_pixel(lat, lon, data.satellite_zoom)
	var mosaic_px := float(SatelliteFetcher.TILE_PX * SatelliteFetcher.SPAN)
	return (px - data.satellite_origin_px) / mosaic_px

static func _terrain_mesh(data: LocationData) -> MeshInstance3D:
	var size := data.grid_size
	var step := WORLD_SIZE / float(size - 1)
	var hs := _heights(data)
	var rng := _range_of(hs)
	var mn := rng.x
	var mx := rng.y
	var relief := mx - mn
	var urban := not data.buildings.is_empty()
	var verts := PackedVector3Array()
	var normals := PackedVector3Array()
	var colors := PackedColorArray()
	var indices := PackedInt32Array()
	var uvs := PackedVector2Array()
	var has_sat := data.satellite_texture != null
	var grass := Color(0.35, 0.48, 0.24)  # PRD grass #5A7A3C
	var dry := Color(0.55, 0.50, 0.34)
	var rock := Color(0.43, 0.42, 0.38)  # PRD rock #6E6A62
	var urban_ground := Color(0.54, 0.51, 0.45)  # PRD pavement #8A8274
	if data.season == LocationData.Season.AUTUMN:
		grass = Color(0.55, 0.52, 0.30)
	elif data.season == LocationData.Season.WINTER:
		grass = Color(0.60, 0.62, 0.55)
	elif data.season == LocationData.Season.SPRING:
		grass = Color(0.48, 0.62, 0.36)
	for z in size:
		for x in size:
			var h := hs[z * size + x]
			var wx := (x - size / 2.0) * step
			var wz := (z - size / 2.0) * step
			verts.append(Vector3(wx, h, wz))
			var hx0 := hs[z * size + maxi(x - 1, 0)]
			var hx1 := hs[z * size + mini(x + 1, size - 1)]
			var hz0 := hs[maxi(z - 1, 0) * size + x]
			var hz1 := hs[mini(z + 1, size - 1) * size + x]
			var slope_x := (hx1 - hx0) / (2.0 * step)
			var slope_z := (hz1 - hz0) / (2.0 * step)
			var normal := Vector3(-slope_x, 1.0, -slope_z).normalized()
			normals.append(normal)
			var t := clampf((h - mn) / maxf(mx - mn, 0.001), 0.0, 1.0)
			var base_color := grass.lerp(dry, clampf(t * 1.4, 0.0, 1.0))
			if t > 0.72:
				base_color = dry.lerp(rock, (t - 0.72) / 0.28)
			var steep := clampf(1.0 - normal.y, 0.0, 1.0) * 3.2
			base_color = base_color.lerp(rock, clampf(steep, 0.0, 0.75))
			if relief > 22.0 and t > 0.84 and steep < 0.35:
				base_color = base_color.lerp(Color(0.90, 0.91, 0.92), 0.6)  # alpine tops only
			elif data.season == LocationData.Season.WINTER \
					and relief > 8.0 and t > 0.50 and steep < 0.40:
				base_color = base_color.lerp(Color(0.88, 0.89, 0.90), 0.55)  # winter snow line
			# Settled ground reads as warm pavement, never bleached:
			# real OSM cities, and any low-relief place in real metres
			# (its procedural dressing is a town too). Alpine valleys
			# keep meadow green even where the floor is flat.
			if urban or data.relief_metres < 120.0:
				base_color = urban_ground.lerp(grass, _hash(x * 0.7, z * 0.7) * 0.25)
			var shade := 0.94 + _hash(x * 1.3, z * 1.7) * 0.10
			# PRD §4.4: never bleached (max luminance 0.85 under the
			# golden sun) but never the near-black of the old grade.
			base_color = Color(base_color.r * shade * 0.96,
				base_color.g * shade * 0.96, base_color.b * shade * 0.96)
			if has_sat:
				# Imagery is the albedo; vertex colour is only a slope
				# shade so relief still reads under the photograph.
				uvs.append(satellite_uv(data, wx, wz))
				# Warm, pale drape: lifted toward the PRD pavement
				# read so the foreground stops reading as dark
				# mottled satellite green/brown.
				var s := 0.99 + 0.08 * normal.y
				colors.append(Color(minf(s * 1.07, 1.0), s, minf(s * 0.84, 1.0)))
			else:
				# Tiled photographic grain breaks flat ground reads.
				uvs.append(Vector2(wx, wz) * 0.22)
				colors.append(land_color(Vector2(wx, wz), data.land_polygons, base_color))
	for z in size - 1:
		for x in size - 1:
			var a := z * size + x
			var b := a + 1
			var c := a + size
			var d := c + 1
			indices.append_array([a, b, c, b, d, c])
	return _colored_mesh(verts, normals, colors, indices, 0.97, false,
		uvs, data.satellite_texture if has_sat else _detail_texture())

static func _far_ground(data: LocationData) -> MeshInstance3D:
	# A broad, fog-tinted apron so the terrain disc never ends in void.
	var size := data.grid_size
	var hs := _heights(data)
	var edge_sum := 0.0
	var edge_n := 0
	for i in size:
		edge_sum += hs[i] + hs[(size - 1) * size + i] \
			+ hs[i * size] + hs[i * size + size - 1]
		edge_n += 4
	var plane := PlaneMesh.new()
	plane.size = Vector2(3200, 3200)
	var mi := _add(null, plane, _mat(Color(0.66, 0.62, 0.52), 1.0))  # hazed apron, PRD §3.3
	# Buried well under the far mesh so it only fills pinhole gaps;
	# at edge height it read as a flat bleached ring past the town.
	mi.position.y = edge_sum / maxf(float(edge_n), 1.0) - 2.4
	return mi

static func _far_terrain(data: LocationData) -> MeshInstance3D:
	# Backdrop terrain from the zoom-8 DEM, buried near the viewpoint
	# and relief-boosted with distance so real Alps read at 5 km.
	var grid := data.far_grid_size
	if data.far_heights.size() != grid * grid:
		return MeshInstance3D.new()
	var extent := data.far_extent
	var step := extent / float(grid - 1)
	var offset := Vector3((0.5 - data.far_centre_frac.x) * extent, -2.2,
		(0.5 - data.far_centre_frac.y) * extent)
	var verts := PackedVector3Array()
	var normals := PackedVector3Array()
	var colors := PackedColorArray()
	var indices := PackedInt32Array()
	var grass := Color(0.52, 0.55, 0.38)  # olive-beige hills (r1)
	var dry := Color(0.72, 0.64, 0.47)
	var rock := Color(0.46, 0.44, 0.41)
	for z in grid:
		for x in grid:
			var wx := (float(x) - float(grid - 1) / 2.0) * step
			var wz := (float(z) - float(grid - 1) / 2.0) * step
			var world := Vector3(wx, 0, wz) + offset
			var dist := Vector2(world.x, world.z).length()
			var boost := 1.0 + 1.9 * smoothstep(300.0, 1600.0, dist)
			var bury := lerpf(16.0, 0.0, smoothstep(160.0, 520.0, dist))
			var h := 3.0 + (data.far_heights[z * grid + x] - 3.0) * boost - bury
			verts.append(Vector3(wx, h, wz))
			var hx0 := data.far_heights[z * grid + maxi(x - 1, 0)]
			var hx1 := data.far_heights[z * grid + mini(x + 1, grid - 1)]
			var hz0 := data.far_heights[maxi(z - 1, 0) * grid + x]
			var hz1 := data.far_heights[mini(z + 1, grid - 1) * grid + x]
			var normal := Vector3(-(hx1 - hx0) / (2.0 * step), 1.0,
				-(hz1 - hz0) / (2.0 * step)).normalized()
			normals.append(normal)
			var above := h - 3.0
			var c := grass.lerp(dry, clampf(above / 60.0, 0.0, 1.0))
			c = c.lerp(rock, clampf((1.0 - normal.y) * 3.0 + above / 160.0, 0.0, 0.8))
			if above > 95.0 and normal.y > 0.75:
				c = c.lerp(Color(0.90, 0.91, 0.92), 0.6)
			if h < data.water_level + 1.0:
				c = Color(0.35, 0.48, 0.52)  # distant lakes read as water
			var fshade := 0.90 + _hash(x * 1.3, z * 1.7) * 0.20
			colors.append(Color(c.r * fshade, c.g * fshade, c.b * fshade))
	for z in grid - 1:
		for x in grid - 1:
			var a := z * grid + x
			var b := a + 1
			var c := a + grid
			var d := c + 1
			indices.append_array([a, b, c, b, d, c])
	var mi := _colored_mesh(verts, normals, colors, indices, 1.0)
	mi.position = offset
	return mi

static func point_in_polygon(point: Vector2, polygon: PackedVector2Array) -> bool:
	var inside := false
	var j := polygon.size() - 1
	for i in polygon.size():
		var pi := polygon[i]
		var pj := polygon[j]
		if (pi.y > point.y) != (pj.y > point.y) \
				and point.x < (pj.x - pi.x) * (point.y - pi.y) / (pj.y - pi.y) + pi.x:
			inside = not inside
		j = i
	return inside

static func land_color(point: Vector2, land: Array, fallback: Color) -> Color:
	for poly in land:
		if point_in_polygon(point, poly["points"]):
			match str(poly["class"]):
				"water": return Color(0.30, 0.50, 0.60)
				"forest": return Color(0.27, 0.41, 0.25)
				"grass": return Color(0.47, 0.60, 0.37)
				"field": return Color(0.70, 0.63, 0.43)
				"urban": return Color(0.64, 0.61, 0.55)
	return fallback

static func _water(data: LocationData) -> MeshInstance3D:
	var plane := PlaneMesh.new()
	plane.size = Vector2(WORLD_SIZE, WORLD_SIZE)
	plane.subdivide_width = 32
	plane.subdivide_depth = 32
	# Seine PBR: river blue #3A7CA5 (r1), roughness 0.08-0.15,
	# dielectric reflection (env sky + sun spec), micro-wave normals.
	var m := _mat(Color(0.23, 0.49, 0.65), 0.12)
	m.metallic = 0.04
	m.albedo_texture = _detail_texture()
	m.normal_texture = _detail_texture()
	m.normal_scale = 0.35
	m.uv1_scale = Vector3(48.0, 48.0, 48.0)
	var mi := _add(null, plane, m)
	mi.position.y = data.water_level
	return mi

static func _box_mat(root: Node3D, pos: Vector3, scl: Vector3, mat: Material) -> void:
	var mi := _add(root, _box_mesh(), mat)
	mi.position = pos
	mi.scale = scl

static func _box(root: Node3D, pos: Vector3, scl: Vector3, color: Color) -> void:
	_box_mat(root, pos, scl, _mat(color))

static var _roof_mats: Dictionary = {}

## Real roof colour for one footprint, averaged from the satellite
## mosaic (the only view of a roof a map actually gives you). Alpha 0
## means "no imagery": the caller falls back to the slate material.
static func sampled_roof_color(data: LocationData, wx: float, wz: float,
		size_x: float, size_z: float) -> Color:
	var img := data.satellite_image
	if img == null:
		return Color(0, 0, 0, 0)
	var acc := Color(0, 0, 0)
	var n := 0
	for dz in [-0.25, 0.0, 0.25]:
		for dx in [-0.25, 0.0, 0.25]:
			var uv := satellite_uv(data, wx + dx * size_x, wz + dz * size_z)
			var px := clampi(int(uv.x * float(img.get_width())), 0, img.get_width() - 1)
			var py := clampi(int(uv.y * float(img.get_height())), 0, img.get_height() - 1)
			acc += img.get_pixel(px, py)
			n += 1
	return acc / float(maxi(n, 1))

static func _roof_mat(data: LocationData, pos: Vector3, size_x: float, size_z: float) -> Material:
	var c := sampled_roof_color(data, pos.x, pos.z, size_x, size_z)
	if c.a == 0.0:
		return _slate()
	# A green-dominant or near-black sample is vegetation/shadow
	# under the footprint, not a roof: use the PRD slate instead.
	if (c.g > c.r * 1.04 and c.g > c.b * 1.05) or c.r + c.g + c.b < 0.30:
		return _slate()
	# Quantized cache: hundreds of buildings, a couple of dozen real
	# roof colours (slate greys, terracotta, asphalt, pale concrete).
	var q := Color(roundf(c.r * 12.0) / 12.0, roundf(c.g * 12.0) / 12.0,
		roundf(c.b * 12.0) / 12.0)
	if _roof_mats.has(q):
		return _roof_mats[q]
	if _roof_mats.size() > 28:
		return _slate()
	var m := _mat(q, 0.85)
	_roof_mats[q] = m
	return m

static func _mansard(root: Node3D, cx: float, base_y: float, cz: float,
		size_x: float, size_z: float, roof_h: float, seed_v: float,
		mat: Material = null) -> void:
	var mi := _add(root, _cyl(0.52, 1.0, 1.0, 4), mat if mat != null else _slate())
	mi.rotation.y = PI / 4.0
	mi.position = Vector3(cx, base_y + roof_h / 2.0, cz)
	mi.scale = Vector3(size_x * 0.48, roof_h, size_z * 0.48)

static func _building(root: Node3D, pos: Vector3, size_x: float, size_z: float,
		height_world: float, seed_v: float, data: LocationData = null,
		roof_shape: String = "") -> void:
	var facades := _facades()
	_box_mat(root, pos + Vector3(0, height_world / 2.0, 0),
		Vector3(size_x, height_world, size_z),
		facades[int(seed_v * int(facades.size() - 1)) % facades.size()])
	var roof_mat: Material = _roof_mat(data, pos, size_x, size_z) if data != null else _slate()
	if roof_shape == "flat":
		_box_mat(root, pos + Vector3(0, height_world + 0.18, 0),
			Vector3(size_x * 1.02, 0.36, size_z * 1.02), roof_mat)
		return
	var roof_h := clampf(minf(size_x, size_z) * 0.22, 0.7, 2.0)
	_mansard(root, pos.x, pos.y + height_world, pos.z, size_x, size_z, roof_h, seed_v, roof_mat)
	# Dormers + chimneys break the roofline (PRD §4.2); near blocks only.
	if pos.length() < 62.0 and height_world > 3.2:
		var n_d := clampi(int(size_x / 1.6), 1, 4)
		for di in n_d:
			var dx := (float(di) - float(n_d - 1) / 2.0) * 1.5
			_box_mat(root, pos + Vector3(dx, height_world + roof_h * 0.52, size_z * 0.30),
				Vector3(0.42, 0.52, 0.30), roof_mat)
		_box_mat(root, pos + Vector3(size_x * 0.28, height_world + roof_h + 0.22, 0),
			Vector3(0.34, 0.55, 0.34), _mat(Color(0.62, 0.55, 0.46), 0.95))

static func _buildings(root: Node3D, data: LocationData) -> void:
	var rng := RandomNumberGenerator.new()
	rng.seed = data.seed_value + 7
	# 2x the preset count, in a 9-98 ring: the foreground roofscape
	# must reach the frame bottom (PRD §4.2), not start past a hole.
	for i in RenderSettings.procedural_buildings_for(data.quality_preset) * 2:
		var angle := rng.randf_range(0.0, TAU)
		var dist := 15.0 + pow(rng.randf(), 0.75) * 83.0
		var pos := Vector3(cos(angle) * dist, 0, sin(angle) * dist)
		if data.landmark_type != "none" and Vector2(pos.x, pos.z).distance_to(
				landmark_world_pos(data)) < 14.0:
			continue
		if _near_building(data, pos):
			continue
		if _path_dist(Vector2(pos.x, pos.z), _river_path(data)) < RIVER_HALF + 4.5:
			continue
		var ground := _ground_at(data, pos.x, pos.z)
		if ground < data.water_level + 0.5:
			continue
		pos.y = ground - 0.25
		# Smaller blocks (r1); same RNG call count, stream intact.
		_building(root, pos, rng.randf_range(3.6, 6.6), rng.randf_range(3.6, 6.6),
			rng.randf_range(2.7, 4.6), rng.randf(), data)

static func _ground_at(data: LocationData, world_x: float, world_z: float) -> float:
	var hs := _heights(data)
	var size := data.grid_size
	var gx := clampi(int((world_x / WORLD_SIZE + 0.5) * float(size)), 0, size - 1)
	var gz := clampi(int((world_z / WORLD_SIZE + 0.5) * float(size)), 0, size - 1)
	return hs[gz * size + gx]

static func _real_buildings(root: Node3D, data: LocationData) -> void:
	var sorted := data.buildings.duplicate()
	sorted.sort_custom(func(a: Dictionary, b: Dictionary) -> bool:
		return (float(a["x"]) ** 2 + float(a["z"]) ** 2) \
			< (float(b["x"]) ** 2 + float(b["z"]) ** 2))
	var placed := 0
	var cap := RenderSettings.max_buildings_for(data.quality_preset)
	# The landmark's own OSM footprint (e.g. the cathedral as one beige
	# box) must not duplicate the procedural landmark model.
	var site := landmark_site_xz(data)
	for b in sorted:
		if placed >= cap:
			break
		var pos := Vector3(float(b["x"]), 0, float(b["z"]))
		if data.landmark_type != "none" \
				and Vector2(pos.x, pos.z).distance_to(site) < 17.0:
			continue
		if _near_landmark_candidate(data, pos.x, pos.z):
			continue  # the archetype model stands here instead
		if absf(pos.x) > 105.0 or absf(pos.z) > 105.0:
			continue
		pos.y = _ground_at(data, pos.x, pos.z) - 0.6
		var height_world := clampf(float(b["height"]) * METRES_TO_WORLD, 1.8, 19.0)
		_building(root, pos, float(b["size_x"]), float(b["size_z"]),
			height_world, _hash(pos.x, pos.z), data, str(b.get("roof_shape", "")))
		placed += 1

static func _city_silhouette(root: Node3D, data: LocationData) -> void:
	# Hazy low blocks beyond the detailed area, so a city reaches the
	# horizon instead of stopping at the terrain edge.
	var rng := RandomNumberGenerator.new()
	rng.seed = data.seed_value + 99
	var haze := _mat(Color(0.66, 0.59, 0.47), 1.0)  # hazed limestone, not white boxes
	var silhouette_count := RenderSettings.silhouette_count_for(data.quality_preset)
	for i in silhouette_count:
		var angle := TAU * float(i) / float(silhouette_count) + rng.randf_range(-0.05, 0.05)
		var dist := rng.randf_range(125.0, 195.0)
		var pos := Vector3(cos(angle) * dist, 0, sin(angle) * dist)
		pos.y = _ground_at(data, clampf(pos.x, -108.0, 108.0), clampf(pos.z, -108.0, 108.0)) - 0.5
		_box_mat(root, pos + Vector3(0, rng.randf_range(1.6, 3.6), 0),
			Vector3(rng.randf_range(7, 14), rng.randf_range(3.2, 7.2), rng.randf_range(7, 14)), haze)

static func _roads(root: Node3D, data: LocationData) -> void:
	var asphalt := _mat(Color(0.31, 0.31, 0.32), 0.98)
	var water_polys := _polys(data, ["water"])
	for line in data.roads:
		var pts: PackedVector2Array = line
		for i in pts.size() - 1:
			var a := pts[i]
			var b := pts[i + 1]
			var mid := (a + b) / 2.0
			if absf(mid.x) > 108.0 or absf(mid.y) > 108.0:
				continue
			var seg := _add(root, _box_mesh(), asphalt)
			var length := a.distance_to(b)
			seg.scale = Vector3(length, 0.06, 1.7)
			var y := _ground_at(data, mid.x, mid.y) + 0.08
			for wp in water_polys:
				if point_in_polygon(mid, wp):
					y = data.water_level + 1.1  # bridge deck over the channel
					break
			seg.position = Vector3(mid.x, y, mid.y)
			seg.rotation.y = -atan2(b.y - a.y, b.x - a.x)

## True offset (world XZ) of the landmark's real site from the
## viewpoint, before clamping. Falls back to the fixed offset when
## the data carries no site (older tests, hand-built LocationData).
static func landmark_site_xz(data: LocationData) -> Vector2:
	if data.has_landmark_site:
		return OsmFetcher.local_xz(data.landmark_lat, data.landmark_lon,
			data.latitude, data.longitude)
	return LANDMARK_POS

## Where the model actually stands: the true bearing from the
## viewpoint, clamped into the detailed terrain (<=95 units) and
## pushed out to reading distance when the viewpoint is at (or very
## near) the site itself, so the camera never starts inside the
## model or underneath a tower that fills the whole frame.
static func landmark_world_pos(data: LocationData) -> Vector2:
	var xz := landmark_site_xz(data)
	var len := xz.length()
	if len > 95.0:
		return xz / len * 95.0
	if len < 34.0:
		var dir := xz / len if len > 0.5 else LANDMARK_POS.normalized()
		return dir * 38.0
	return xz

static func _landmark(data: LocationData) -> Node3D:
	var pos := landmark_world_pos(data)
	var root := LandmarkBuilder.build(data.landmark_type)
	root.position = Vector3(pos.x, _ground_at(data, pos.x, pos.y) - 0.3, pos.y)
	# A landmark pulled in from its true site would crop out of
	# frame at true scale; compensate apparent size part-way.
	var site_len := landmark_site_xz(data).length()
	if site_len > pos.length() + 1.0 and pos.length() > 0.0:
		var s := clampf(sqrt(pos.length() / site_len) * 2.0, 0.44, 1.0)
		# Widen X/Z vs Y so the pulled-in tower is no thin spike.
		root.scale = Vector3(s * 1.55, s * 1.08, s * 1.55)
	if data.landmark_type == "eiffel":
		# Override glossy copper with matte bronze-brown #6B4A2F.
		var iron := _mat(Color(0.32, 0.225, 0.135), 0.58)
		iron.metallic = 0.45
		for child in root.get_children():
			if child is MeshInstance3D:
				(child as MeshInstance3D).material_override = iron
	return root

static func _beam(parent: Node3D, from: Vector3, to: Vector3, radius: float, mat: Material) -> void:
	var mi := _add(parent, _cyl(radius * 0.8, radius, 1.0, 6), mat)
	var dir := to - from
	var length := dir.length()
	var y_axis := dir / length
	var x_axis := Vector3.UP.cross(y_axis).normalized()
	if x_axis.length() < 0.01:
		x_axis = Vector3.RIGHT
	var z_axis := x_axis.cross(y_axis).normalized()
	x_axis = y_axis.cross(z_axis).normalized()
	mi.transform = Transform3D(
		Basis(x_axis * radius, y_axis * length, z_axis * radius),
		(from + to) / 2.0)

static func _random_pos(rng: RandomNumberGenerator) -> Vector3:
	var angle := rng.randf_range(0.0, TAU)
	var dist := rng.randf_range(15.0, 102.0)
	return Vector3(cos(angle) * dist, 0, sin(angle) * dist)

static var _canopy_mesh: SphereMesh
static var _trunk_mat: StandardMaterial3D

static func _canopy() -> SphereMesh:
	if _canopy_mesh == null:
		_canopy_mesh = SphereMesh.new()
		_canopy_mesh.radial_segments = 14
		_canopy_mesh.rings = 10
		_canopy_mesh.radius = 1.0
		_canopy_mesh.height = 2.0
	return _canopy_mesh

static var _leaf_card_tex: Texture2D
static var _card_mats_by_season: Dictionary = {}
static var _card_mesh: QuadMesh

## Leaf-cluster alpha texture: crossed alpha cards read as foliage
## mass from any angle, where a shaded sphere reads as a lollipop.
static func _leaf_card_texture() -> Texture2D:
	if _leaf_card_tex != null:
		return _leaf_card_tex
	var img := Image.create(256, 256, false, Image.FORMAT_RGBA8)
	img.fill(Color(0, 0, 0, 0))
	for i in 1100:
		var cx := 128.0 + (_hash(i * 1.71, 3.3) - 0.5) * 190.0
		var cy := 128.0 + (_hash(3.3, i * 2.39) - 0.5) * 190.0
		if Vector2(cx - 128.0, cy - 128.0).length() > 105.0:
			continue
		var v := 0.45 + _hash(i * 0.37, i * 0.91) * 0.5
		var leaf := Color(v * 0.90, v, v * 0.84, 1.0)
		var s := 3 + int(_hash(i * 5.1, 7.7) * 4.0)
		img.fill_rect(Rect2i(int(cx), int(cy), s, maxi(2, s - 1)), leaf)
	var tex := ImageTexture.create_from_image(img)
	_leaf_card_tex = tex
	return tex

static func _card_mat(season: int, variant: int) -> Material:
	var key := LocationData.clamp_season(season)
	if not _card_mats_by_season.has(key):
		var bases: Array = _leaves(key)
		var mats: Array = []
		for b in bases.slice(0, 3):
			var base := (b as StandardMaterial3D).albedo_color
			var m := StandardMaterial3D.new()
			m.albedo_texture = _leaf_card_texture()
			m.albedo_color = Color(minf(base.r * 1.05, 1.0), minf(base.g * 1.02, 1.0),
				minf(base.b * 1.05, 1.0))
			m.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA_SCISSOR
			m.alpha_scissor_threshold = 0.42
			m.cull_mode = BaseMaterial3D.CULL_DISABLED
			m.roughness = 0.95
			mats.append(m)
		_card_mats_by_season[key] = mats
	var mats2: Array = _card_mats_by_season[key]
	return mats2[variant % mats2.size()]

static func _broadleaf(root: Node3D, pos: Vector3, rng: RandomNumberGenerator,
		leaves: Array, trunk_mat: Material, season: int = LocationData.Season.SUMMER) -> void:
	# Real broadleaf (PRD §4.4): trunk, a dark crown core for volume,
	# and three crossed foliage cards (Ø 4-7 m) — textured alpha
	# clusters, never one flat sphere.
	var trunk := _add(root, _cyl(0.09, 0.17, 1.15, 8), trunk_mat)
	trunk.position = pos + Vector3(0, 0.57, 0)
	var r := rng.randf_range(0.72, 1.12)
	var centre := pos + Vector3(0, 1.15 + r * 0.85, 0)
	var core := _add(root, _canopy(), leaves[rng.randi_range(0, leaves.size() - 1)])
	core.scale = Vector3(r * 0.40, r * 0.33, r * 0.40)
	core.position = centre
	if _card_mesh == null:
		_card_mesh = QuadMesh.new()
		_card_mesh.size = Vector2(3.6, 3.1)
	var mat := _card_mat(season, rng.randi_range(0, 2))
	for k in 3:
		var card := _add(root, _card_mesh, mat)
		card.scale = Vector3(r, r, r)
		card.rotation.y = float(k) * PI / 3.0 + rng.randf_range(-0.2, 0.2)
		card.position = centre + Vector3(0, (float(k) - 1.0) * 0.22, 0)

static func _pine(root: Node3D, pos: Vector3, rng: RandomNumberGenerator, leaves: Array) -> void:
	# Layered pine (PRD §4.4): trunk + three needle-textured tiers,
	# never a bare cone.
	var h := rng.randf_range(3.2, 5.0)
	var trunk := _add(root, _cyl(0.07, 0.12, 0.9, 7),
		_mat(Color(0.30, 0.23, 0.16), 0.95))
	trunk.position = pos + Vector3(0, 0.45, 0)
	for k in 3:
		var t := float(k) / 3.0
		var tier := _add(root, _cyl(0.06, lerpf(1.25, 0.45, t), h * 0.42, 10),
			leaves[rng.randi_range(0, leaves.size() - 1)])
		tier.position = pos + Vector3(0, 0.8 + t * h * 0.62 + h * 0.21, 0)

static func _vegetation(root: Node3D, data: LocationData) -> void:
	var rng := RandomNumberGenerator.new()
	rng.seed = data.seed_value + 21
	var leaves := _leaves(data.season)
	var trunk_mat := _mat(Color(0.36, 0.28, 0.20), 0.95)
	var urban := not data.buildings.is_empty() or data.relief_metres < 120.0
	var green_polys := _polys(data, ["forest", "grass"])
	var count := RenderSettings.vegetation_count_for(data.quality_preset, urban)
	for i in count:
		var pos := _random_pos(rng)
		# Prefer parks and forests: resample a couple of times to land
		# inside green land cover when the place has any.
		for attempt in 3:
			var inside_green := false
			for gp in green_polys:
				if point_in_polygon(Vector2(pos.x, pos.z), gp):
					inside_green = true
					break
			if inside_green or green_polys.is_empty():
				break
			if attempt == 2 and rng.randf() > 0.35:
				pos = Vector3(9999, 0, 9999)  # skip: cities keep trees in green areas
				break
			pos = _random_pos(rng)
		if absf(pos.x) > 200.0:
			continue
		if data.landmark_type != "none" and Vector2(pos.x, pos.z).distance_to(
				landmark_world_pos(data)) < 12.0:
			continue  # keep the landmark's clearing free of trees
		var ground := _ground_at(data, pos.x, pos.z)
		if ground < data.water_level + 0.4:
			continue
		if urban and _near_building(data, pos):
			continue
		pos.y = ground
		# Cities get street broadleafs; pines belong to the hills.
		if rng.randf() < (0.85 if urban else 0.50):
			_broadleaf(root, pos, rng, leaves, trunk_mat, data.season)
		else:
			_pine(root, pos, rng, leaves)

static func _near_building(data: LocationData, pos: Vector3) -> bool:
	for b in data.buildings:
		var dx := pos.x - float(b["x"])
		var dz := pos.z - float(b["z"])
		var reach := maxf(float(b["size_x"]), float(b["size_z"])) * 0.5 + 1.6
		if dx * dx + dz * dz < reach * reach:
			return true
	return false
