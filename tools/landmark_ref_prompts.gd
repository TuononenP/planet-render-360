extends SceneTree

## Writes the prompt sheet for AI-made landmark reference images (visual
## quality plan, L-1.1): visual-plan/refs/landmarks/PROMPTS.md.
##   godot --headless --path . --script tools/landmark_ref_prompts.gd
##
## Two views per landmark, matching the first two bearings of
## tools/capture_landmarks.gd (front, quarter), so a reference and a
## capture can sit side by side. Save each image as
## visual-plan/refs/landmarks/<type>/ai_front.jpg and ai_quarter.jpg.
## The compass bearing of the camera follows the registry's yaw_deg: the
## model is built with its front to the south (camera on +Z, looking
## north) and then turned clockwise by yaw_deg.

const VIEWS := [["front", 0.0, "straight on, from the front"], ["quarter", 40.0, "from a front three-quarter angle"]]
## Sculptures and organic forms first (plan L-4.1), then the rest in registry order.
const PRIORITY := ["liberty", "christ_redeemer", "leshan", "sphinx", "motherland", "moai", "sydney_opera", "atomium", "chain_bridge", "lions"]

func _init() -> void:
	var entries: Array = LocationData.landmarks().duplicate()
	entries.sort_custom(func(a, b): return _rank(a) < _rank(b))
	var lines := PackedStringArray([
		"# AI reference images for landmarks",
		"",
		"Generated by `tools/landmark_ref_prompts.gd`. Save each image as",
		"`visual-plan/refs/landmarks/<type>/ai_front.jpg` / `ai_quarter.jpg` and fill in `SOURCE.md`",
		"for the folder (tool, date, prompt used). Images are not committed (`visual-plan/refs/**/*.jpg`",
		"is gitignored). AI images can invent proportions and details: use real photographs",
		"and independently sourced dimensions for accuracy and silhouette scoring.",
		"",
		"Prompt template: *Photorealistic documentary photograph of {name} ({kind}), {height} m tall,",
		"{view}, camera at about eye height from {distance}, from the {compass} side, clear daylight,",
		"no people, no text overlays, no watermark, whole building in frame.*",
		"",
	])
	for e in entries:
		var yaw := float(e.get("yaw_deg", 0.0))
		lines.append("## %s — %s%s" % [e["type"], e["name"], "  (priority)" if _rank(e) < PRIORITY.size() else ""])
		lines.append("height %.0f m, kind %s" % [float(e.get("height_m", 0.0)), str(e.get("kind", "landmark"))])
		for v in VIEWS:
			var compass := fposmod(180.0 - float(v[1]) + yaw, 360.0)
			lines.append("- `ai_%s.jpg`: %s, camera on compass bearing %.0f° from the landmark (%s side)" % [
				v[0], v[2], compass, _name_of(compass)])
		lines.append("")
	var path := ProjectSettings.globalize_path("res://visual-plan/refs/landmarks/PROMPTS.md")
	DirAccess.make_dir_recursive_absolute(path.get_base_dir())
	var f := FileAccess.open(path, FileAccess.WRITE)
	f.store_string("\n".join(lines))
	f.close()
	print("PROMPTS written: %d landmarks -> %s" % [entries.size(), path])
	quit(0)

func _rank(e: Dictionary) -> int:
	var t := str(e["type"])
	for i in PRIORITY.size():
		if PRIORITY[i] in t:
			return i
	return PRIORITY.size()

func _name_of(deg: float) -> String:
	return ["north", "north-east", "east", "south-east", "south", "south-west", "west", "north-west"][int(roundf(deg / 45.0)) % 8]
